<resources>
    <!-- Le fond de fenêtre doit valoir la couleur du ciel nocturne : sinon un fond
         blanc apparaît au lancement, et transparaît derrière la barre de navigation
         là où le fond céleste s'arrête. -->
    <style name="Theme.Astro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
